local function makeDraggable(button)
    local dragging = false
    local moved = false
    local dragStart
    local startPos

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = button.Position
        end
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement
        ) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then
                moved = true
            end

            button.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    return function()
        return moved
    end
end

local function createActionBtn(name, labelText, yOffset, callback)
    local actBtn = Instance.new("TextButton", MobileGui)
    actBtn.Name = name
    actBtn.Size = UDim2.new(0, 95, 0, 28)
    actBtn.Position = UDim2.new(0, 10, 0.5, yOffset)
    actBtn.BackgroundColor3 = Color3.fromRGB(35, 30, 45)
    actBtn.Text = labelText .. ": OFF"
    actBtn.TextColor3 = Color3.fromRGB(200, 180, 195)
    actBtn.Font = Enum.Font.FredokaOne
    actBtn.TextSize = 10
    actBtn.AutoButtonColor = false
    actBtn.ZIndex = 10

    Instance.new("UICorner", actBtn).CornerRadius = UDim.new(0, 6)

    local aStroke = Instance.new("UIStroke", actBtn)
    aStroke.Color = Color3.fromRGB(255, 100, 180)
    aStroke.Thickness = 1

    local wasMoved = makeDraggable(actBtn)
    local actState = false

    actBtn.MouseButton1Click:Connect(function()
        -- A drag should only move the button, not toggle it.
        if wasMoved() then
            return
        end

        actState = not actState

        if actState then
            actBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 180)
            actBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            actBtn.Text = labelText .. ": ON"
        else
            actBtn.BackgroundColor3 = Color3.fromRGB(35, 30, 45)
            actBtn.TextColor3 = Color3.fromRGB(200, 180, 195)
            actBtn.Text = labelText .. ": OFF"
        end

        callback(actState)
    end)

    return actBtn
end

