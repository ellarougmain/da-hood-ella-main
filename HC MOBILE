-- Jump Boost Force Handler
local function applyCustomJump(hum)
    if cfg.jumpPowerMaster and cfg.jumpPowerActive then
        local hrp = hum.Parent and hum.Parent:FindFirstChild("HumanoidRootPart")
        if hrp then
            task.defer(function()
                hrp.AssemblyLinearVelocity = Vector3.new(
                    hrp.AssemblyLinearVelocity.X,
                    cfg.jumpValue * 1.5,
                    hrp.AssemblyLinearVelocity.Z
                )
            end)
        end
    end
end

local function setupCharacterJumping(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 3)
    if hum then
        hum.Jumping:Connect(function()
            applyCustomJump(hum)
        end)
    end
end

if lp.Character then
    setupCharacterJumping(lp.Character)
end

