    title.TextXAlignment = Enum.TextXAlignment.Left

    local colors = {
        Color3.fromRGB(255, 90, 110), Color3.fromRGB(255, 155, 70), Color3.fromRGB(255, 225, 90),
        Color3.fromRGB(175, 235, 90), Color3.fromRGB(95, 210, 125), Color3.fromRGB(110, 235, 195),
        Color3.fromRGB(90, 220, 235), Color3.fromRGB(100, 175, 255), Color3.fromRGB(80, 120, 255),
        Color3.fromRGB(55, 65, 170), Color3.fromRGB(155, 100, 240), Color3.fromRGB(205, 100, 245),
        Color3.fromRGB(255, 105, 180), Color3.fromRGB(255, 125, 155), Color3.fromRGB(255, 175, 145),
        Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 175, 190), Color3.fromRGB(35, 30, 45)
    }

    local swatches = {}
    for i, color in ipairs(colors) do
        local row = math.floor((i - 1) / 9)
        local col = (i - 1) % 9
        local btn = Instance.new("TextButton", card)
        btn.Size = UDim2.new(0, 20, 0, 20)
        btn.Position = UDim2.new(0, 10 + (col * 31), 0, 26 + (row * 28))
        btn.BackgroundColor3 = color
        btn.Text = ""
        btn.AutoButtonColor = false
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = currentTheme.STROKE
        stroke.Thickness = 1
        swatches[i] = stroke

        btn.MouseButton1Click:Connect(function()
            callback(color)
            for j, s in ipairs(swatches) do
                s.Color = (j == i) and Color3.fromRGB(255, 255, 255) or currentTheme.STROKE
                s.Thickness = (j == i) and 2 or 1
            end
        end)
    end
end

