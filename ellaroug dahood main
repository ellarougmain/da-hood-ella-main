local function filterWhitelist(query)
    query = string.lower(query)
    for _, item in ipairs(whitelistToggles) do
        local matchName = string.find(string.lower(item.Text), query)
        local matchSub = string.find(string.lower(item.Subtext), query)
        if query == "" or matchName or matchSub then
            item.Card.Visible = true
        else
            item.Card.Visible = false
        end
    end
end
searchBox:GetPropertyChangedSignal("Text"):Connect(function() filterWhitelist(searchBox.Text) end)

