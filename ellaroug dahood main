            local hrp = v.Character.HumanoidRootPart
            if cfg.hitboxEnabled then
                hrp.Size = Vector3.new(cfg.hitboxSize, cfg.hitboxSize, cfg.hitboxSize)
                hrp.Transparency = cfg.hitboxTransparency
                hrp.Color = cfg.hitboxColor
